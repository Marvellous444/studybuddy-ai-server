# The server tries providers in order and moves to the next one when a
# provider is rate limited or has no quota left, so more than one key means the
# app keeps working when one runs out. Every key here is optional on its own,
# but with none of them set the server has nothing to call.
#
# Never commit the real .env. Only this example file belongs in git.

# Gemini leads the chain. The free tier needs no card, which is why it is first.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Second in the chain. Free tier at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Third in the chain. Free tier at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional. Only used for the OpenRouter entry; the server also has its own
# list of fallback models it will try if this one fails.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Optional, defaults to 3000.
PORT=3000

# Set automatically by Render. Do not set this by hand; it is here only
# because the server reads it to report which build is live in /health.
RENDER_GIT_COMMIT=
